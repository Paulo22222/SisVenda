<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SisVenda.PedidoPage"
             Title="Pedidos">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Novo" Clicked="ToolbarItem_Novo_Clicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="12">
            <Label Text="Pedidos" FontSize="20" FontAttributes="Bold" />

            <CollectionView x:Name="pedidosCollectionView" ItemsSource="{Binding}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="8" Margin="0,6" BorderColor="#DDD" CornerRadius="6">
                            <Grid ColumnDefinitions="Auto,2*,1.5*,1.5*,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding Id}" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ClienteNome}" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding DataFormatada}" VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="{Binding TotalFormatado}" VerticalOptions="Center" />

                                <Button Grid.Column="4" Text="Editar" Clicked="Editar_Clicked" CommandParameter="{Binding Id}" Margin="4,0" WidthRequest="80" />
                                <Button Grid.Column="5" Text="Excluir" BackgroundColor="#FF6666" Clicked="Excluir_Clicked" CommandParameter="{Binding Id}" Margin="4,0" WidthRequest="80" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
